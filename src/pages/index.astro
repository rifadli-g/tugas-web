---
// Ganti tiga nilai ini dengan data kamu.
const name = "Rifadli & Horison [BOOKING LAPANGAN]";
const tagline = "SISTEM BOOKING LAPANGAN - SOON";
const email = "rifadlihorison@gmail.com";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{name}</title>
    <meta name="description" content={`Halaman profil ${name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,900&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <div class="pitch" aria-hidden="true">
        <svg
          class="pitch-lines"
          viewBox="0 0 1000 600"
          preserveAspectRatio="xMidYMid slice"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect x="30" y="30" width="940" height="540" fill="none" stroke="var(--line)" stroke-width="4" />
          <line x1="500" y1="30" x2="500" y2="570" stroke="var(--line)" stroke-width="4" />
          <circle cx="500" cy="300" r="80" fill="none" stroke="var(--line)" stroke-width="4" />
          <circle cx="500" cy="300" r="4" fill="var(--line)" />
          <!-- left goal area -->
          <path d="M30,220 A110,110 0 0 1 30,380" fill="none" stroke="var(--line)" stroke-width="4" />
          <rect x="30" y="255" width="55" height="90" fill="none" stroke="var(--line)" stroke-width="4" />
          <circle cx="30" cy="30" r="20" fill="none" stroke="var(--line)" stroke-width="4" />
          <circle cx="30" cy="570" r="20" fill="none" stroke="var(--line)" stroke-width="4" />
          <!-- right goal area -->
          <path d="M970,220 A110,110 0 0 0 970,380" fill="none" stroke="var(--line)" stroke-width="4" />
          <rect x="915" y="255" width="55" height="90" fill="none" stroke="var(--line)" stroke-width="4" />
          <circle cx="970" cy="30" r="20" fill="none" stroke="var(--line)" stroke-width="4" />
          <circle cx="970" cy="570" r="20" fill="none" stroke="var(--line)" stroke-width="4" />
        </svg>
      </div>
      <div class="content">
        <h1 class="name">{name}</h1>
        <p class="tagline">{tagline}</p>
        <a class="contact" href={`mailto:${email}`}>{email}</a>
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    --turf-dark: #14522f;
    --turf-light: #1a6339;
    --line: rgba(245, 240, 232, 0.55);
    --text: #f5f0e8;
    --muted: #cfe4d6;
    --accent: #ffc53d;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    color: var(--text);
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    overflow-x: hidden;
    background: repeating-linear-gradient(
      0deg,
      var(--turf-dark) 0 48px,
      var(--turf-light) 48px 96px
    );
  }

  main {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding: 6vw 6vw 8vw;
    padding-bottom: calc(8vw + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
  }

  .pitch {
    position: absolute;
    inset: 0;
  }

  .pitch-lines {
    width: 100%;
    height: 100%;
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    padding: 2rem 2.25rem;
    background: rgba(10, 26, 17, 0.38);
    backdrop-filter: blur(6px);
    border-radius: 4px;
  }

  .name {
    font-family: "Fraunces", serif;
    font-weight: 900;
    font-size: clamp(2.8rem, 9vw, 7rem);
    line-height: 0.95;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(16px);
    animation: rise 0.8s ease-out 0.1s forwards;
  }

  .tagline {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--muted);
    margin: 0 0 2rem;
    max-width: 40ch;
  }

  .contact {
    display: inline-block;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
    font-size: 0.95rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact:hover,
  .contact:focus-visible {
    color: var(--accent);
  }

  .contact:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .name {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    main {
      padding: 12vw 7vw 12vw;
    }
    .content {
      padding: 1.5rem 1.5rem;
    }
  }
</style>
